# Experiment records ARE part of the repo: eval tables, training logs, the
# effective config each run used, per-clip score dumps and the queue scripts
# are how a result stays checkable months later. Only the things that are big
# and reproducible from them are excluded.

# model weights, optimizer state, and raw tensor dumps (~67 MB+ each)
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz

# archives and datasets
*.zip
*.tar
*.tar.*
*.7z
*.tgz
*.mp4
*.part
data/

# raw dataset frame dumps fetched for fixed-camera admission studies
# (re-downloadable from source, not generated by our code)
work_dirs/**/original_sbm/
work_dirs/**/corrected_sbm/

# macOS zip-extraction junk
__MACOSX/
._*

# anything a run can regenerate cheaply and that bloats the tree
work_dirs/**/viz/
outputs/**/*.png

# vendored/downloaded toolchains and third-party repos, not our code
work_dirs/paper_tools/
work_dirs/paper_dependencies/

# generated deployment bundle (code + weights + input frames snapshot)
work_dirs/paper_edge_bundle/

# python
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# envs
.venv/
uv.lock

# editors / OS
.vscode/
.idea/
.DS_Store

# AI
.agent/
.claude/

# symlink to an out-of-repo Drive folder (trailing slash misses it: git
# tests symlinks by lstat type, not target, so "paper_work/" never matches)
paper_work

# stray AI-session transcripts left at repo root, not experiment records
/*.log